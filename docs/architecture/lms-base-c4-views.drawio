        <mxCell id="lendings-hdr-0" value="Business Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lendings-hdr-1" value="Architecture Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1490" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lendings-hdr-2" value="Implementation View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3075" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lendings-ca-note" value="Adoption of Clean Architecture pattern" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1680" y="40" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lendings-b-legend" value="Lendings broken into its business capabilities. Grey lines: the Lendings API delegates to each capability.&lt;br&gt;Each capability&#39;s own ports show which other subdomains it needs.&lt;br&gt;The &#39;own lendings only&#39; checks are done in LendingController, not in a service." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="1400" width="690" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lendings-a-legend" value="Ball-and-socket and dashed arrows: each layer depends on the one below, as in Clean Architecture.&lt;br&gt;&lt;b&gt;Thick lines&lt;/b&gt;: the layer uses another module&#39;s repositories or domain classes, not its API.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation (another module&#39;s internals, an external system reached from inside the core, or a dependency pointing outwards).&lt;br&gt;Not drawn: every layer uses the Exceptions Module.&lt;br&gt;Extra dependency in the base project: Interface Adapters also use the EBR API directly.&lt;br&gt;The limit of 3 and the overdue block are in LendingServiceImpl; fines and overdue days in the Lending entity." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="1400" width="1070" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lendings-i-legend" value="Dashed grey boxes: template elements with no counterpart in the package.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation. Red dashed arrows point outwards, against the dependency rule.&lt;br&gt;Extra dependencies in the base project: Controllers use Domain directly; Services use Repositories.&lt;br&gt;LendingMapper (services) correctly uses BookService and ReaderService; LendingServiceImpl bypasses them.&lt;br&gt;Domain classes carry JPA annotations." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1400" width="1890" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lendings-sep-header" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="110" as="sourcePoint" />
            <mxPoint x="3930" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
