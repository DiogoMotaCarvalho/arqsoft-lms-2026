        <mxCell id="books-hdr-0" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" value="Business Logic View" vertex="1">
