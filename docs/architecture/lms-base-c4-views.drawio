        <mxCell id="users-hdr-1" value="Architecture Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1490" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="users-hdr-2" value="Implementation View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3075" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="users-ca-note" value="Adoption of Clean Architecture pattern" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1680" y="40" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="users-b-legend" value="The user side of Identity &amp;amp; Access. Grey lines: the API delegates to each capability.&lt;br&gt;It needs no other subdomain; every other subdomain needs it.&lt;br&gt;Login and registration are in the Auth Module (next page)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="1250" width="690" height="110" as="geometry" />
        </mxCell>
        <mxCell id="users-a-legend" value="Ball-and-socket and dashed arrows: each layer depends on the one below, as in Clean Architecture.&lt;br&gt;&lt;b&gt;Thick lines&lt;/b&gt;: the layer uses another module&#39;s repositories or domain classes, not its API.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation (another module&#39;s internals, an external system reached from inside the core, or a dependency pointing outwards).&lt;br&gt;Not drawn: every layer uses the Exceptions Module.&lt;br&gt;Extra dependency in the base project: Interface Adapters also use the EBR API directly.&lt;br&gt;Only Shared is required: the User Module is a leaf that the other modules depend on." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="1250" width="1070" height="110" as="geometry" />
        </mxCell>
        <mxCell id="users-i-legend" value="Dashed grey boxes: template elements with no counterpart in the package.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation. Red dashed arrows point outwards, against the dependency rule.&lt;br&gt;Extra dependencies in the base project: Controllers use Domain directly; Services use Repositories.&lt;br&gt;Framework coupling: User implements Spring Security&#39;s UserDetails and UserService its UserDetailsService.&lt;br&gt;Domain classes carry JPA annotations." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1250" width="1890" height="110" as="geometry" />
        </mxCell>
