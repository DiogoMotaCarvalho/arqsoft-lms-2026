          <mxGeometry x="3975" y="40" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mm-note" value="Adoption of a Modular Monolith Architecture pattern" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2405" y="40" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vl-note" value="VL Negócio N2" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="4165" y="40" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-legend" value="Ball-and-socket: the component holding the socket uses the interface of the component holding the ball, as in the code. Socket and line colour = the component that depends.&lt;br&gt;Grey lines: the LMS API port delegates to each subdomain&#39;s REST port.&lt;br&gt;Identity &amp;amp; Access = authentication + user management." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="160" y="2630" width="1090" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-legend" value="Ball-and-socket: the socket&#39;s module uses the ball&#39;s module API. Colour = the module that depends.&lt;br&gt;&lt;b&gt;Thick socket line&lt;/b&gt;: bypasses that API, using the other module&#39;s repositories or querying its tables directly.&lt;br&gt;Not drawn: every module uses Shared and Exceptions; Bootstrapping uses every domain module.&lt;br&gt;Cycles: Author↔Book, Book↔Genre, Book↔Lending, Lending↔Reader, Shared↔Author/Book/Lending/Reader." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1410" y="2630" width="1770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="i-legend" value="Ball-and-socket: the package uses Persistence or File Storage. Colour = the package that depends.&lt;br&gt;Inter-package dependencies are the ones in the Architecture Logic View." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="3340" y="2630" width="1430" height="90" as="geometry" />
        </mxCell>
