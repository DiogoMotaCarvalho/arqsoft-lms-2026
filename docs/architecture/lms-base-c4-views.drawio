        <mxCell id="readers-hdr-0" value="Business Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="160" height="40" as="geometry" />
