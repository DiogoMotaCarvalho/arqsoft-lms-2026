        </mxCell>
        <mxCell id="books-hdr-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" value="Architecture Logic View" vertex="1">
          <mxGeometry height="40" width="160" x="1490" y="40" as="geometry" />
        </mxCell>
        <mxCell id="books-hdr-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" value="Implementation View" vertex="1">
          <mxGeometry height="40" width="160" x="3075" y="40" as="geometry" />
        </mxCell>
        <mxCell id="books-ca-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" value="Adoption of Clean Architecture pattern" vertex="1">
          <mxGeometry height="40" width="180" x="1680" y="40" as="geometry" />
        </mxCell>
        <mxCell id="books-b-legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" value="Books broken into its business capabilities. Grey lines: the Books API delegates to each capability.&lt;br&gt;Each capability&#39;s own ports show which other subdomains it needs." vertex="1">
          <mxGeometry height="110" width="690" x="100" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="books-a-legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" value="Ball-and-socket and dashed arrows: each layer depends on the one below, as in Clean Architecture.&lt;br&gt;&lt;b&gt;Thick lines&lt;/b&gt;: the layer uses another module&#39;s repositories or domain classes, not its API.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation (another module&#39;s internals, an external system reached from inside the core, or a dependency pointing outwards).&lt;br&gt;Not drawn: every layer uses the Exceptions Module.&lt;br&gt;Extra dependency in the base project: Interface Adapters also use the EBR API directly.&lt;br&gt;Red dashed arrow: the Book entity uses UpdateBookRequest, a service request class." vertex="1">
          <mxGeometry height="110" width="1070" x="830" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="books-i-legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" value="Dashed grey boxes: template elements with no counterpart in the package.&lt;br&gt;&lt;font color=&#39;#E06666&#39;&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation. Red dashed arrows point outwards, against the dependency rule.&lt;br&gt;Extra dependencies in the base project: Controllers use Domain directly; Services use Repositories.&lt;br&gt;GenreBookCountDTO lives here but belongs to Genre&#39;s queries, one cause of the Book–Genre cycle.&lt;br&gt;The top-5 query joins the Lending table. Domain classes carry JPA annotations." vertex="1">
          <mxGeometry height="110" width="1890" x="2000" y="1520" as="geometry" />
        </mxCell>
