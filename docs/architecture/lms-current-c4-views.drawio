<mxCell id="impl-note" value="&lt;b&gt;REST LMS API:&lt;/b&gt; HTTP/JSON, JWT Bearer, OpenAPI at /api-docs; Actuator /actuator/health, /actuator/info&lt;br&gt;&lt;b&gt;API Ninjas:&lt;/b&gt; HTTPS GET /v1/historicalevents, X-API-KEY header&lt;br&gt;&lt;b&gt;Google Books:&lt;/b&gt; HTTPS GET /books/v1/volumes?q=isbn:..., optional API key, 5 s timeout&lt;br&gt;&lt;b&gt;Open Library:&lt;/b&gt; HTTPS GET /api/books?bibkeys=ISBN:...&amp;amp;format=json&amp;amp;jscmd=data, 5 s timeout&lt;br&gt;&lt;b&gt;Webhook:&lt;/b&gt; HTTP POST of a JSON payload to notifications.webhook.base-url, 5 s timeout" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=11;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1270" y="430" width="440" height="100" as="geometry"/></mxCell>
