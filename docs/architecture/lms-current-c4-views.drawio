<mxCell id="auth-hdr-0" value="Business Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="auth-hdr-1" value="Architecture Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="auth-hdr-2" value="Implementation View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3075" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="auth-ca-note" value="Adoption of Clean Architecture pattern" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="40" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="auth-b-legend" value="The authentication side of Identity &amp;amp; Access. Grey lines: the API delegates to each capability.&lt;br&gt;Both capabilities are public endpoints: no login is needed to call them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="100" y="1250" width="690" height="110" as="geometry"/></mxCell>
<mxCell id="auth-a-legend" value="Ball-and-socket and dashed arrows: each layer depends on the one below, as in Clean Architecture.&lt;br&gt;&lt;b&gt;Thick lines&lt;/b&gt;: the layer uses another module's repositories or domain classes, not its API.&lt;br&gt;&lt;font color='#E06666'&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation (another module's internals, an external system reached from inside the core, or a dependency pointing outwards).&lt;br&gt;Not drawn: every layer uses the Exceptions Module.&lt;br&gt;The Auth Module is only an adapter: Frameworks &amp;amp; Drivers and Interface Adapters, over the User Module." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="1250" width="1070" height="110" as="geometry"/></mxCell>
<mxCell id="auth-i-legend" value="Dashed grey boxes: template elements with no counterpart in the package.&lt;br&gt;&lt;font color='#E06666'&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation. Red dashed arrows point outwards, against the dependency rule.&lt;br&gt;Use-case and security logic in the controller: AuthApi authenticates and builds the JWT claims itself.&lt;br&gt;Not marked: UserViewMapper and UserView (borderline: User's REST adapter code)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2000" y="1250" width="1890" height="110" as="geometry"/></mxCell>
