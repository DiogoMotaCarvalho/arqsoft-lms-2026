<mxCell id="notifications-hdr-0" value="Business Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="notifications-hdr-1" value="Architecture Logic View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="notifications-hdr-2" value="Implementation View" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3075" y="40" width="160" height="40" as="geometry"/></mxCell>
<mxCell id="notifications-ca-note" value="Adoption of Clean Architecture pattern" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1680" y="40" width="180" height="40" as="geometry"/></mxCell>
<mxCell id="notifications-b-legend" value="New since the base project. Notifications has no API of its own: it reacts to the lending events.&lt;br&gt;Email and SMS are delivered through gateways that only log today; the webhook is the one channel that leaves the system." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="100" y="1220" width="690" height="110" as="geometry"/></mxCell>
<mxCell id="notifications-a-legend" value="Ball-and-socket and dashed arrows: each layer depends on the one below, as in Clean Architecture.&lt;br&gt;&lt;b&gt;Thick lines&lt;/b&gt;: the layer uses another module's repositories or domain classes, not its API.&lt;br&gt;&lt;font color='#E06666'&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation (another module's internals, an external system reached from inside the core, or a dependency pointing outwards).&lt;br&gt;Not drawn: every layer uses the Exceptions Module.&lt;br&gt;The one allowed edge to Lending is the published event (LendingEvent, LendingEventType): one-way, enforced by ArchUnit.&lt;br&gt;Red dashed arrow: CompositeNotifier (Application Rules) writes the audit through NotificationRecordRepository, an infrastructure class.&lt;br&gt;The Notification domain is framework-free (ArchUnit)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="1220" width="1070" height="110" as="geometry"/></mxCell>
<mxCell id="notifications-i-legend" value="Dashed grey boxes: template elements with no counterpart in the package.&lt;br&gt;&lt;font color='#E06666'&gt;&lt;b&gt;Soft red&lt;/b&gt;&lt;/font&gt;: violation. Red dashed arrows point outwards, against the dependency rule.&lt;br&gt;The channels in Gateways realise the NotificationChannel port declared in Services.&lt;br&gt;Red socket: Services use the Spring Data repository and the JPA entity in the infrastructure package directly.&lt;br&gt;Wiring (NotificationConfig) enables @Async and registers the renderer." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="2000" y="1220" width="1890" height="110" as="geometry"/></mxCell>
<mxCell id="notifications-sep-header" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="110" as="sourcePoint"/><mxPoint x="3930" y="110" as="targetPoint"/></mxGeometry></mxCell>
