<mxfile host="Electron" pages="3">
  <diagram id="deployment" name="Deployment (as is)"><mxGraphModel dx="1720" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="deployment-1" value="&lt;b&gt;Deployment of the base project&lt;/b&gt; (commit c716e06): everything runs on one developer machine" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="deployment-2" value="«device»&lt;br&gt;&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser (Swagger UI at /swagger-ui)&lt;br&gt;Postman (Authors collection, run by hand)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="150" as="geometry"/></mxCell>
<mxCell id="deployment-3" value="«device»&lt;br&gt;&lt;b&gt;Developer workstation&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="60" width="900" height="580" as="geometry"/></mxCell>
<mxCell id="deployment-4" value="«execution environment»&lt;br&gt;&lt;b&gt;JVM 17&lt;/b&gt; (IDE run or java -jar)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="400" height="290" as="geometry"/></mxCell>
<mxCell id="deployment-5" value="«artifact»&lt;br&gt;&lt;b&gt;psoft-g1-0.0.1-SNAPSHOT.jar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spring Boot 3.2.5, embedded Tomcat :8080&lt;/i&gt;&lt;br&gt;&lt;br&gt;profile &lt;b&gt;bootstrap&lt;/b&gt; active by default:&lt;br&gt;seeds users, authors, genres, books,&lt;br&gt;readers, lendings and photos&lt;br&gt;JWT signed with an RSA key read from the classpath" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="175" width="350" height="205" as="geometry"/></mxCell>
<mxCell id="deployment-6" value="«execution environment»&lt;br&gt;&lt;b&gt;H2 database server&lt;/b&gt; (TCP mode, started by hand)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="400" height="290" as="geometry"/></mxCell>
<mxCell id="deployment-7" value="«database»&lt;br&gt;&lt;b&gt;~/psoft-g1&lt;/b&gt; (H2 file in the user's home)&lt;br&gt;&lt;br&gt;schema created and altered on start-up&lt;br&gt;(spring.jpa.hibernate.ddl-auto=update)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="965" y="175" width="350" height="205" as="geometry"/></mxCell>
<mxCell id="deployment-8" value="«folder»&lt;br&gt;&lt;b&gt;./uploads-psoft-g1&lt;/b&gt;&lt;br&gt;photos, relative to the working directory&lt;br&gt;(test images committed to the repository)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="460" width="350" height="140" as="geometry"/></mxCell>
<mxCell id="deployment-9" value="«external system»&lt;br&gt;&lt;b&gt;API Ninjas&lt;/b&gt;&lt;br&gt;api.api-ninjas.com/v1/historicalevents" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1430" y="230" width="250" height="150" as="geometry"/></mxCell>
<mxCell id="deployment-10" value="HTTP :8080, REST/JSON, JWT bearer" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deployment-2" target="deployment-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="deployment-11" value="JDBC over TCP&lt;br&gt;jdbc:h2:tcp://localhost/~/psoft-g1" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deployment-5" target="deployment-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="deployment-12" value="file I/O" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deployment-5" target="deployment-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="deployment-13" value="HTTPS, X-Api-Key header" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="deployment-5" target="deployment-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="30"/><mxPoint x="1555" y="30"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-14" value="&lt;b&gt;Not present in the base project&lt;/b&gt;&lt;br&gt;• no container image, no build server, no environments (dev / test / prod), no deployment scripts or run instructions&lt;br&gt;• secrets committed in src/main/resources: the RSA private key, the datasource password and the API Ninjas key&lt;br&gt;• no health or readiness endpoint, no logging or monitoring set-up beyond Spring Boot defaults&lt;br&gt;• the database must be started separately, and the data seeder runs on every start unless the profile is changed" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1640" height="100" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
  <diagram id="build" name="Build and test (as is)"><mxGraphModel dx="1480" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="build-1" value="&lt;b&gt;Build and test workflow of the base project&lt;/b&gt;: local and manual only" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="build-2" value="Developer workstation" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="build-3" value="&lt;b&gt;IDE + Maven (installed locally)&lt;/b&gt;&lt;br&gt;&lt;i&gt;mvnw is unusable: .mvn/wrapper is missing&lt;br&gt;and *.jar is git-ignored&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="build-4" value="&lt;b&gt;compile&lt;/b&gt;&lt;br&gt;&lt;i&gt;javac release 17&lt;br&gt;Lombok 1.18.30, MapStruct 1.5.5&lt;br&gt;(fails on JDK 24: verified)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="build-5" value="&lt;b&gt;test (Surefire)&lt;/b&gt;&lt;br&gt;&lt;i&gt;102 tests: 89 unit + 13 Spring context&lt;br&gt;one phase, H2 in-memory&lt;br&gt;about 26 s&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="build-6" value="&lt;b&gt;package&lt;/b&gt;&lt;br&gt;&lt;i&gt;spring-boot repackage&lt;br&gt;psoft-g1-0.0.1-SNAPSHOT.jar&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="build-7" value="&lt;b&gt;run by hand&lt;/b&gt;&lt;br&gt;&lt;i&gt;IDE or java -jar&lt;br&gt;H2 server must already be running&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="80" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="build-8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="build-3" target="build-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="build-4" target="build-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="build-5" target="build-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;" edge="1" parent="1" source="build-6" target="build-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-12" value="&lt;b&gt;git push&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bitbucket repository&lt;br&gt;356 commits, 5 authors&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="build-13" value="source" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="build-3" target="build-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-14" value="After a push, nothing runs. Stages a pipeline would have, absent in the base project:" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="700" height="20" as="geometry"/></mxCell>
<mxCell id="build-15" value="CI build on every push" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="260" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-16" value="coverage report and gate (JaCoCo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-17" value="mutation testing (PIT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="260" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-18" value="static analysis (Checkstyle, Sonar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="260" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-19" value="architecture rules (ArchUnit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-20" value="artifact or image publishing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-21" value="deployment to environments" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="910" y="330" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-22" value="smoke tests after deploy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;fontColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="build-23" value="&lt;b&gt;Other observations&lt;/b&gt;&lt;br&gt;• no JDK version is pinned (no toolchains, no enforcer rule), so the build silently depends on the developer's JDK&lt;br&gt;• unit and Spring integration tests share one phase; Failsafe is not used and *IntegrationTest classes run under Surefire&lt;br&gt;• JUnit 4 (junit:junit) is declared but unused; all tests are JUnit 5&lt;br&gt;• 7 tests are commented out (TestAuthApi: 4, LendingServiceImplTest: 3) and AuthorControllerIntegrationTest has no tests&lt;br&gt;• API checks were Postman collections run by hand (src/main/resources/assets): Authors, Books, Lendings, Readers, and a combined collection with its environment" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1400" height="120" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
