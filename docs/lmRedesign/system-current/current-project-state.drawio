  <diagram id="deployment" name="Deployment (current)"><mxGraphModel dx="1620" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="deployment-1" value="&lt;b&gt;Deployment of the current project&lt;/b&gt;: one JAR promoted through DEV, PP and PROD by Jenkins" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="deployment-2" value="«device»&lt;br&gt;&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser (Swagger UI at /swagger-ui)&lt;br&gt;REST clients with a JWT" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="deployment-3" value="«device»&lt;br&gt;&lt;b&gt;Jenkins&lt;/b&gt;&lt;br&gt;&lt;br&gt;jobs psoft-g1-ci, psoft-g1-pp, psoft-g1-prod&lt;br&gt;archived JARs: validated/ and accepted/&lt;br&gt;credentials: deploy SSH key, smoke-test user" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="deployment-4" value="«device»&lt;br&gt;&lt;b&gt;Linux server&lt;/b&gt; (systemd)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="860" height="640" as="geometry"/></mxCell>
<mxCell id="deployment-5" value="«execution environment»&lt;br&gt;&lt;b&gt;psoft-g1@dev&lt;/b&gt; (JVM 17+), port 8181" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="520" height="175" as="geometry"/></mxCell>
<mxCell id="deployment-6" value="«artifact»&lt;br&gt;&lt;b&gt;/opt/psoft-g1/dev/app.jar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spring Boot 3.2.5, embedded Tomcat&lt;/i&gt;&lt;br&gt;user psoft-g1-dev, config /etc/psoft-g1/dev.env&lt;br&gt;APP_ENVIRONMENT=dev; H2 in memory, seeded at start (profile bootstrap)&lt;br&gt;Actuator: /actuator/health/readiness, /actuator/info (environment, commit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="155" width="480" height="115" as="geometry"/></mxCell>
<mxCell id="deployment-7" value="«execution environment»&lt;br&gt;&lt;b&gt;psoft-g1@pp&lt;/b&gt; (JVM 17+), port 8182" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="420" y="305" width="520" height="175" as="geometry"/></mxCell>
<mxCell id="deployment-8" value="«artifact»&lt;br&gt;&lt;b&gt;/opt/psoft-g1/pp/app.jar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spring Boot 3.2.5, embedded Tomcat&lt;/i&gt;&lt;br&gt;user psoft-g1-pp, config /etc/psoft-g1/pp.env&lt;br&gt;APP_ENVIRONMENT=pp; H2 in memory, seeded at start (profile bootstrap)&lt;br&gt;Actuator: /actuator/health/readiness, /actuator/info (environment, commit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="480" height="115" as="geometry"/></mxCell>
<mxCell id="deployment-9" value="«execution environment»&lt;br&gt;&lt;b&gt;psoft-g1@prod&lt;/b&gt; (JVM 17+), port 8183" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="520" height="175" as="geometry"/></mxCell>
<mxCell id="deployment-10" value="«artifact»&lt;br&gt;&lt;b&gt;/opt/psoft-g1/prod/app.jar&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spring Boot 3.2.5, embedded Tomcat&lt;/i&gt;&lt;br&gt;user psoft-g1-prod, config /etc/psoft-g1/prod.env&lt;br&gt;APP_ENVIRONMENT=prod; H2 in memory, seeded at start (profile bootstrap)&lt;br&gt;Actuator: /actuator/health/readiness, /actuator/info (environment, commit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="545" width="480" height="115" as="geometry"/></mxCell>
<mxCell id="deployment-11" value="«folder»&lt;br&gt;&lt;b&gt;/var/lib/psoft-g1/&amp;lt;env&amp;gt;/uploads&lt;/b&gt;&lt;br&gt;photos, one folder per environment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="deployment-12" value="«external system»&lt;br&gt;&lt;b&gt;Google Books, Open Library&lt;/b&gt;&lt;br&gt;HTTPS, 5 s timeout each" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1340" y="110" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="deployment-13" value="«external system»&lt;br&gt;&lt;b&gt;API Ninjas&lt;/b&gt;&lt;br&gt;HTTPS, X-Api-Key header" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1340" y="260" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="deployment-14" value="«external system»&lt;br&gt;&lt;b&gt;Webhook endpoint&lt;/b&gt;&lt;br&gt;HTTP POST, JSON (only if configured)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=center;fontSize=11;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1340" y="400" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="deployment-15" value="HTTP, REST/JSON, JWT bearer" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="deployment-2" target="deployment-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="565"/><mxPoint x="350" y="602"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-16" value="scp + systemctl&lt;br&gt;over SSH (user deploy)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="deployment-3" target="deployment-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="160"/><mxPoint x="350" y="212"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-17" value="" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="deployment-10" target="deployment-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="543"/><mxPoint x="1300" y="543"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-18" value="" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="deployment-10" target="deployment-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="543"/><mxPoint x="1300" y="543"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-19" value="" style="endArrow=open;endSize=10;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="deployment-10" target="deployment-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="543"/><mxPoint x="1300" y="543"/></Array></mxGeometry></mxCell>
<mxCell id="deployment-20" value="&lt;b&gt;Still the same as in the base project&lt;/b&gt;&lt;br&gt;• secrets committed in src/main/resources: the RSA private key, the datasource password and the API Ninjas key&lt;br&gt;• no persistent database in any environment: each deployment starts from the seeded demo data&lt;br&gt;• email and SMS channels only write to the log; no mail or SMS provider is integrated" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1540" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
  <diagram id="build" name="Build and test (current)"><mxGraphModel dx="1500" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="550" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="build-1" value="&lt;b&gt;Build and test workflow of the current project&lt;/b&gt;: the same commands locally and in Jenkins" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="build-2" value="psoft-g1-ci, on every push to any branch (Maven wrapper, Maven 3.9.6, JDK 17+)" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="700" height="20" as="geometry"/></mxCell>
<mxCell id="build-3" value="&lt;b&gt;compile&lt;/b&gt;&lt;br&gt;&lt;i&gt;./mvnw clean compile&lt;br&gt;Lombok 1.18.38, MapStruct 1.5.5&lt;br&gt;builds on JDK 17 and 24&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-4" value="&lt;b&gt;static analysis&lt;/b&gt;&lt;br&gt;&lt;i&gt;spotless:check (google-java-format)&lt;br&gt;checkstyle:check&lt;br&gt;fails on any warning&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="245" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-5" value="&lt;b&gt;unit tests (Surefire)&lt;/b&gt;&lt;br&gt;&lt;i&gt;500 tests, *Test&lt;br&gt;includes 6 ArchUnit rules&lt;br&gt;JaCoCo report&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-6" value="&lt;b&gt;integration tests (Failsafe)&lt;/b&gt;&lt;br&gt;&lt;i&gt;51 tests, *IT, JaCoCo agent&lt;br&gt;Spring context, H2 in memory,&lt;br&gt;stubbed external services&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="655" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-7" value="&lt;b&gt;coverage&lt;/b&gt;&lt;br&gt;&lt;i&gt;unit + integration tests&lt;br&gt;fails below 60% of lines&lt;br&gt;(67% today)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-8" value="&lt;b&gt;mutation tests (PIT)&lt;/b&gt;&lt;br&gt;&lt;i&gt;model and services&lt;br&gt;fails below 75%&lt;br&gt;(80% today)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1065" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-9" value="&lt;b&gt;package&lt;/b&gt;&lt;br&gt;&lt;i&gt;psoft-g1-0.0.1-SNAPSHOT.jar&lt;br&gt;commit embedded in build-info&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1270" y="80" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="build-10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-3" target="build-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-4" target="build-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-5" target="build-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-13" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-6" target="build-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-7" target="build-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-15" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-8" target="build-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-16" value="main only" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="build-17" value="&lt;b&gt;deploy DEV + smoke test&lt;/b&gt;&lt;br&gt;&lt;i&gt;archive validated/, start PP&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="build-18" value="&lt;b&gt;psoft-g1-pp: deploy PP + smoke test&lt;/b&gt;&lt;br&gt;&lt;i&gt;same JAR, by CI build number&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="325" y="255" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="build-19" value="&lt;b&gt;manual approval&lt;/b&gt;&lt;br&gt;&lt;i&gt;release-managers, up to 7 days&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="255" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="build-20" value="&lt;b&gt;archive accepted/&lt;/b&gt;&lt;br&gt;&lt;i&gt;re-checks PP still runs it&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="895" y="255" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="build-21" value="&lt;b&gt;psoft-g1-prod: deploy PROD + smoke test&lt;/b&gt;&lt;br&gt;&lt;i&gt;same JAR, by PP build number&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1180" y="255" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="build-22" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="build-9" target="build-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1355" y="210"/><mxPoint x="165" y="210"/></Array></mxGeometry></mxCell>
<mxCell id="build-23" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-17" target="build-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-24" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-18" target="build-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-25" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-19" target="build-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-26" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="build-20" target="build-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="build-27" value="automatic gate: the pipeline stops if it fails" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="240" height="26" as="geometry"/></mxCell>
<mxCell id="build-28" value="manual step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="240" height="26" as="geometry"/></mxCell>
<mxCell id="build-29" value="no gate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="240" height="26" as="geometry"/></mxCell>
<mxCell id="build-30" value="&lt;b&gt;Other observations&lt;/b&gt;&lt;br&gt;• the Maven wrapper works and downloads Maven 3.9.6; no JDK version is pinned (no toolchains, no enforcer rule), Java 17 is the compile target&lt;br&gt;• unit tests (*Test, Surefire) and integration tests (*IT, Failsafe) are separate phases and separate pipeline stages&lt;br&gt;• results published in Jenkins: JUnit, Checkstyle (Warnings NG), coverage and mutation (Coverage plugin); JaCoCo and PIT HTML reports archived; SonarQube is configured but not run&lt;br&gt;• the ArchUnit cycle baseline (archunit_store/) is versioned; a missing baseline fails the build, so new module cycles fail in Jenkins too&lt;br&gt;• still from the base project: TestAuthApi is commented out and AuthorControllerIT has no tests; Postman collections remain in src/main/resources/assets" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="1430" height="120" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
  <diagram id="tests" name="Tests and coverage (current)"><mxGraphModel dx="1340" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="tests-1" value="&lt;b&gt;Tests, coverage and mutation score of the current project&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="tests-2" value="Test pyramid (tests that actually run)" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="500" height="20" as="geometry"/></mxCell>
<mxCell id="tests-3" value="&lt;b&gt;System / API: 32 tests&lt;/b&gt;&lt;br&gt;&lt;i&gt;9 classes, MockMvc over the full Spring context,&lt;br&gt;login, roles, external services stubbed&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fillColor=#CFE8F5;" vertex="1" parent="1"><mxGeometry x="170" y="85" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="tests-4" value="&lt;b&gt;Spring integration: 19 tests&lt;/b&gt;&lt;br&gt;&lt;i&gt;8 classes, repositories, services, events, H2 in memory&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;fillColor=#CFE8F5;" vertex="1" parent="1"><mxGeometry x="110" y="155" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="tests-5" value="&lt;b&gt;Unit, no Spring: 500 tests&lt;/b&gt;&lt;br&gt;&lt;i&gt;56 classes: domain, application services with fake repositories,&lt;br&gt;adapters with stubbed gateways, 6 ArchUnit rules&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9DDF3;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="540" height="70" as="geometry"/></mxCell>
<mxCell id="tests-6" value="Line coverage by module and layer (JaCoCo, unit + integration tests)" style="text;html=1;whiteSpace=wrap;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="600" height="20" as="geometry"/></mxCell>
